# One file, two services. Copy this to `.env` and paste your key.
#
#   cp .env.example .env
#   # edit OPENAI_API_KEY below
#   make dev

OPENAI_API_KEY=sk-...

# Optional — per-agent overrides for the first-cut agent (defaults shown).
# AGENT_ID=cs-agent-first-cut
# AGENT_NAME=Customer Support Agent
# AGENT_MODEL=gpt-5.4-mini
# REFUND_CAP_USD=200

# Note: cs_agent_engineered reads its identity (id, name, model, refund cap, language)
# from `cs_agent_engineered/agent-profile.yaml` — not from env vars. Edit that file
# to reconfigure the engineered agent.

# Optional — the model the policy knowledge-base service uses for its
# specialist advisor call (default shown). This one is deliberately NOT the
# console's model dropdown: that switches the agent under test, while the
# policy service stays on a fixed model so the advice both agents read is the
# same evidence whichever model is being demonstrated.
# POLICY_ADVISOR_MODEL=gpt-5.4-mini
